  "conditions": [
    {
      "id": "spinal_cord_injury",
      "name": "Spinal Cord Injury (T6 Complete)",
      "description": "Complete spinal cord injury at the T6 vertebral level, affecting movement and sensation below the chest.",
      "symptoms": [
        "Paraplegia (paralysis of legs)",
        "Loss of sensation below injury level",
        "Bladder and bowel dysfunction",
        "Autonomic dysreflexia risk",
        "Spasticity in lower extremities"
      ],
      "dailyAdjustments": [
        "Manual wheelchair use for mobility",
        "Intermittent catheterization every 4-6 hours",
        "Daily skin checks for pressure sores",
        "Range of motion exercises",
        "Bowel management program"
      ],
      "resources": ["resource_001", "resource_002", "resource_003"],
      "aiGenerated": false,
      "timeline": {
        "week1": "Focus on acute medical stabilization, pain management, and preventing complications. Begin education about injury level.",
        "month1": "Start intensive rehabilitation. Learn wheelchair skills, transfers, and basic self-care. Address emotional adjustment.",
        "month3": "Achieve independence in daily activities. Establish bladder/bowel routines. Prepare for community reintegration.",
        "longTerm": "Maintain health through exercise and medical monitoring. Adapt home/work environments. Build peer support network."
      },
      "relatedGroups": ["group_sci_support", "group_wheelchair_athletes"],
      "diagnosedDate": "2022-03-15T00:00:00Z",
